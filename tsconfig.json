{
  // Type-checks tests, e2e, scripts and tool configs. Package sources are built by tsconfig.build.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "isolatedDeclarations": false,
    "allowImportingTsExtensions": true,
    // Mirrors the vitest alias: tests resolve workspace packages to their sources.
    "paths": { "@otter-player/*": ["./packages/*/src/index.ts"] }
  },
  "include": ["packages/*/test", "packages/*/src/**/*.d.ts", "tests", "scripts", "tooling", "e2e", "*.config.ts"]
}
