{
  // Type-checks tests, e2e, scripts and tool configs. Package sources are built by tsconfig.build.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "isolatedDeclarations": false,
    "allowImportingTsExtensions": true,
    // Mirrors the vitest alias: tests resolve workspace packages to their sources.
    "paths": {
      "@otter-player/pipeline/transmux": ["./packages/pipeline/src/transmux/index.ts"],
      "@otter-player/pipeline/captions": ["./packages/pipeline/src/captions/cea608.ts"],
      "@otter-player/text/render": ["./packages/text/src/render.ts"],
      "@otter-player/surface/gpu": ["./packages/surface/src/gpu.ts"],
      "@otter-player/presentation/canvas-pip": ["./packages/presentation/src/canvas-pip.ts"],
      "@otter-player/presentation/multiview": ["./packages/presentation/src/multiview.ts"],
      "@otter-player/presentation/picture": ["./packages/presentation/src/picture.ts"],
      "@otter-player/presentation/single-audio": ["./packages/presentation/src/single-audio.ts"],
      "@otter-player/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["packages/*/test", "packages/*/src/**/*.d.ts", "tests", "scripts", "tooling", "e2e", "*.config.ts"],
  // Test media: MPEG-TS segments use the .ts extension.
  "exclude": ["e2e/media", "e2e/.site-dist"]
}
