{
  "name": "@otter-player/surface",
  "version": "0.1.0-beta.0",
  "description": "Surface (video / canvas2d / gpu) and Overlay interfaces: picture rect, fit, transform, filters, snapshot.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/surface"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/surface#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gpu": {
      "@otter-player/source": "./src/gpu.ts",
      "types": "./dist/gpu.d.ts",
      "default": "./dist/gpu.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*"
  },
  "otter": {
    "entries": {
      "gpu": "src/gpu.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
