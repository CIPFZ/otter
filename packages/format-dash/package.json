{
  "name": "@otter-player/format-dash",
  "version": "0.1.0-beta.0",
  "description": "DASH format plugin (Shaka adapter).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/format-dash"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/format-dash#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*",
    "@otter-player/engine-adapter-shaka": "workspace:*",
    "@otter-player/media": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
