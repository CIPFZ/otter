{
  "name": "@otter-player/svelte",
  "version": "0.1.0-beta.0",
  "description": "Svelte bindings: an action and a component hosting a preset-made player, and a store over its state (SSR-safe).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/svelte#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./OtterPlayer.svelte": {
      "svelte": "./src/OtterPlayer.svelte",
      "default": "./src/OtterPlayer.svelte"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "devDependencies": {
    "svelte": "5.57.3"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "publishConfig": {
    "access": "public"
  }
}
