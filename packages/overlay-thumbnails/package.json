{
  "name": "@otter-player/overlay-thumbnails",
  "version": "0.1.0-beta.0",
  "description": "Seek preview thumbnails: WebVTT sprite tracks and HLS I-frame playlists for the preview card.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/overlay-thumbnails"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/overlay-thumbnails#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*",
    "@otter-player/media": "workspace:*",
    "media-captions": "1.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
