{
  "name": "@otter-player/decoder-pool",
  "version": "0.1.0-beta.0",
  "description": "Shared Worker decode pool (ADR-008 §3): decoder plugins run in pooled Workers, at most 16 at once, frames come back transferred.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/decoder-pool"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/decoder-pool#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*",
    "@otter-player/media": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
