{
  "name": "@otter-player/engine-adapter-mpegts",
  "version": "0.1.0-beta.0",
  "description": "mpegts.js engine adapter (L1): FLV / MPEG-TS live.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/engine-adapter-mpegts"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/engine-adapter-mpegts#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
