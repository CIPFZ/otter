{
  "name": "@otter-player/decoder-wasm-hevc",
  "version": "0.0.0",
  "private": true,
  "description": "WASM HEVC / H.264 software decoder: Jessibuca 4 jv4-decoder (L2, prebuilt), in the shared decode pool, loaded on demand.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/decoder-wasm-hevc"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/decoder-wasm-hevc#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*",
    "@otter-player/media": "workspace:*",
    "@otter-player/decoder-pool": "workspace:*"
  },
  "otter": {
    "assets": [
      "src/vendor/jessibuca"
    ]
  }
}
