{
  "name": "@otter-player/pipeline",
  "version": "0.1.0-beta.0",
  "description": "Self-built media pipeline: Loader, Demuxer, Remuxer, Buffer, ABR, LiveController. Worker-capable, DOM-free.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/pipeline"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/pipeline#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transmux": {
      "@otter-player/source": "./src/transmux/index.ts",
      "types": "./dist/transmux/index.d.ts",
      "default": "./dist/transmux.js"
    },
    "./captions": {
      "@otter-player/source": "./src/captions/cea608.ts",
      "types": "./dist/captions/cea608.d.ts",
      "default": "./dist/captions.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*"
  },
  "otter": {
    "bundle": [
      "@otter-vendor/hls.js",
      "@otter-vendor/mpegts.js"
    ],
    "entries": {
      "transmux": "src/transmux/index.ts",
      "captions": "src/captions/cea608.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@otter-vendor/hls.js": "workspace:*",
    "@otter-vendor/mpegts.js": "workspace:*"
  }
}
