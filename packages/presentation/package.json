{
  "name": "@otter-player/presentation",
  "version": "0.0.0",
  "description": "PresentationController: window-mode state machine (inline, theater, fullscreen, PiP, document PiP, mini, background).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./multiview": {
      "@otter-player/source": "./src/multiview.ts",
      "types": "./dist/multiview.d.ts",
      "default": "./dist/multiview.js"
    },
    "./picture": {
      "@otter-player/source": "./src/picture.ts",
      "types": "./dist/picture.d.ts",
      "default": "./dist/picture.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*",
    "@otter-player/surface": "workspace:*"
  },
  "otter": {
    "entries": {
      "multiview": "src/multiview.ts",
      "picture": "src/picture.ts"
    }
  }
}
