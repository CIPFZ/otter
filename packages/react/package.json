{
  "name": "@otter-player/react",
  "version": "0.1.0-beta.0",
  "description": "React bindings: a component hosting a preset-made player, and a hook over its store (SSR-safe).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "19.3.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
