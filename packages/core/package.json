{
  "name": "@otter-player/core",
  "version": "0.1.0-beta.0",
  "description": "Otter core: reactive store, typed event bus, plugin registry, error model and QoE hook. Zero DOM.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "publishConfig": {
