{
  "name": "@otter-player/engine-pipeline",
  "version": "0.1.0-beta.0",
  "description": "Otter's own engine (ADR-007 §2): streaming loader -> pipeline transmuxer -> MSE sink, with the LiveController.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/engine-pipeline"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/engine-pipeline#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sink": {
      "@otter-player/source": "./src/mse-sink.ts",
      "types": "./dist/mse-sink.d.ts",
      "default": "./dist/sink.js"
    },
    "./fallback": {
      "@otter-player/source": "./src/fallback.ts",
      "types": "./dist/fallback.d.ts",
      "default": "./dist/fallback.js"
    },
    "./demux": {
      "@otter-player/source": "./src/flv-demux.ts",
      "types": "./dist/flv-demux.d.ts",
      "default": "./dist/demux.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*",
    "@otter-player/media": "workspace:*",
    "@otter-player/pipeline": "workspace:*"
  },
  "otter": {
    "entries": {
      "sink": "src/mse-sink.ts",
      "fallback": "src/fallback.ts",
      "demux": "src/flv-demux.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
