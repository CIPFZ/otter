{
  "name": "@otter-player/demux-mediabunny",
  "version": "0.1.0-beta.0",
  "description": "mediabunny (L1) Demuxer for the WebCodecs backend: local files (format-file) and HLS (format-hls), loaded on demand.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/demux-mediabunny"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/demux-mediabunny#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*",
    "@otter-player/media": "workspace:*",
    "mediabunny": "1.61.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
