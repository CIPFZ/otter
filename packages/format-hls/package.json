{
  "name": "@otter-player/format-hls",
  "version": "0.0.0",
  "description": "HLS format plugin: own CMAF-HLS engine (ADR-010), hls.js for what it leaves out, Shaka for DRM.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*",
    "@otter-player/engine-adapter-hlsjs": "workspace:*",
    "@otter-player/engine-adapter-shaka": "workspace:*",
    "@otter-player/media": "workspace:*",
    "@otter-player/demux-mediabunny": "workspace:*",
    "@otter-player/engine-pipeline": "workspace:*",
    "@otter-player/pipeline": "workspace:*"
  },
  "otter": {
    "mangle": "mangle-cache.json"
  }
}
