{
  "name": "@otter-player/input",
  "version": "0.1.0-beta.0",
  "description": "InputController: unified keyboard, pointer and gesture to action mapping.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/input"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/input#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./remote": {
      "@otter-player/source": "./src/remote.ts",
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*"
  },
  "otter": {
    "entries": {
      "remote": "src/remote.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
