{
  "name": "@otter-player/danmaku",
  "version": "0.1.0-beta.0",
  "description": "Danmaku (scrolling comments) engine: CSS, Canvas 2D, WebGL batch and OffscreenCanvas renderers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/danmaku"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/danmaku#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*",
    "@otter-player/surface": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
