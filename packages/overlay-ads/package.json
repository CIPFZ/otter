{
  "name": "@otter-player/overlay-ads",
  "version": "0.0.0",
  "private": true,
  "description": "Ad overlay driven by timeline interstitial events: countdown and skip button.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/overlay-ads"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/overlay-ads#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
