{
  "name": "@otter-player/media",
  "version": "0.1.0-beta.0",
  "description": "MediaBackend / FormatPlugin / Decoder interfaces, capability detection, deterministic routing and fallback chain.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/media"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/media#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*",
    "@svta/cml-cmcd": "2.8.2",
    "@svta/cml-structured-field-values": "1.1.6",
    "@svta/cml-utils": "1.6.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
