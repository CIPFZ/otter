{
  "name": "@otter-player/presets",
  "version": "0.0.0",
  "description": "Scenario presets (basic, vod, live, lowlatency, ott-drm, surveillance, danmaku, shorts, tv, background).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./basic": {
      "@otter-player/source": "./src/basic.ts",
      "types": "./dist/basic.d.ts",
      "default": "./dist/basic.js"
    },
    "./vod": {
      "@otter-player/source": "./src/vod.ts",
      "types": "./dist/vod.d.ts",
      "default": "./dist/vod.js"
    },
    "./live": {
      "@otter-player/source": "./src/live.ts",
      "types": "./dist/live.d.ts",
      "default": "./dist/live.js"
    },
    "./background": {
      "@otter-player/source": "./src/background.ts",
      "types": "./dist/background.d.ts",
      "default": "./dist/background.js"
    },
    "./lowlatency": {
      "@otter-player/source": "./src/lowlatency.ts",
      "types": "./dist/lowlatency.d.ts",
      "default": "./dist/lowlatency.js"
    },
    "./danmaku": {
      "@otter-player/source": "./src/danmaku.ts",
      "types": "./dist/danmaku.d.ts",
      "default": "./dist/danmaku.js"
    },
    "./tv": {
      "@otter-player/source": "./src/tv.ts",
      "types": "./dist/tv.d.ts",
      "default": "./dist/tv.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/backend-mse": "workspace:*",
    "@otter-player/backend-native": "workspace:*",
    "@otter-player/core": "workspace:*",
    "@otter-player/danmaku": "workspace:*",
    "@otter-player/format-dash": "workspace:*",
    "@otter-player/format-hls": "workspace:*",
    "@otter-player/format-mp4-range": "workspace:*",
    "@otter-player/input": "workspace:*",
    "@otter-player/media": "workspace:*",
    "@otter-player/overlay-thumbnails": "workspace:*",
    "@otter-player/overlay-watermark": "workspace:*",
    "@otter-player/preferences": "workspace:*",
    "@otter-player/presentation": "workspace:*",
    "@otter-player/qoe": "workspace:*",
    "@otter-player/surface": "workspace:*",
    "@otter-player/text": "workspace:*",
    "@otter-player/ui-core": "workspace:*"
  },
  "otter": {
    "entries": {
      "basic": "src/basic.ts",
      "vod": "src/vod.ts",
      "live": "src/live.ts",
      "background": "src/background.ts",
      "lowlatency": "src/lowlatency.ts",
      "danmaku": "src/danmaku.ts",
      "tv": "src/tv.ts"
    }
  }
}
