{
  "name": "@otter-player/text",
  "version": "0.1.0-beta.0",
  "description": "Text tracks overlay: WebVTT, SRT, IMSC1/TTML, CEA-608/708, native and custom cue rendering.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/text"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/text#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./render": {
      "@otter-player/source": "./src/render.ts",
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "dependencies": {
    "@otter-player/core": "workspace:*",
    "@otter-player/media": "workspace:*",
    "@otter-player/surface": "workspace:*",
    "media-captions": "1.0.4"
  },
  "otter": {
    "bundle": [
      "imsc",
      "sax"
    ],
    "entries": {
      "render": "src/render.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "imsc": "1.1.5"
  }
}
