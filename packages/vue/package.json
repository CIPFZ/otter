{
  "name": "@otter-player/vue",
  "version": "0.1.0-beta.0",
  "description": "Vue bindings: a component hosting a preset-made player, and composables over its store (SSR-safe).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIPFZ/otter.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/CIPFZ/otter/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/CIPFZ/otter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@otter-player/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build --config ../../tooling/vite.lib.config.ts"
  },
  "devDependencies": {
    "vue": "3.5.44"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
