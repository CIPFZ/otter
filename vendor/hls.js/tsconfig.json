{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "lib": ["ES2022"],
    // Private, pre-bundled into @otter-player/pipeline (ADR-007 §1): declarations are emitted for the
    // pipeline's type check only (never published), so isolatedDeclarations' explicit return types on
    // every upstream function would be churn against the upstream diff. All other strict options on.
    "isolatedDeclarations": false,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": ["src"]
}
