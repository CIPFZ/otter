{
  "name": "otter-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r run build && pnpm run build:types",
    "build:types": "tsc -b tsconfig.build.json",
    "clean": "pnpm -r exec rm -rf dist",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "size-limit",
    "license:gate": "node scripts/license-gate.ts",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "check:side-effects": "node scripts/check-side-effects.ts",
    "check": "pnpm typecheck && pnpm test && pnpm license:gate && pnpm check:boundaries && pnpm check:side-effects && pnpm size"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
