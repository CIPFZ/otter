{
  "name": "otter-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r run build && pnpm run build:types",
    "build:types": "tsc -b tsconfig.build.json",
    "clean": "pnpm -r exec rm -rf dist",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "size-limit",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "check:side-effects": "node scripts/check-side-effects.ts",
    "check": "pnpm check:vendor && pnpm check:docs-text && pnpm check:boundaries && pnpm check:release-files && pnpm typecheck && pnpm build && pnpm test && pnpm check:side-effects && pnpm check:docs-site && pnpm check:engine-chunks && pnpm size",
    "check:vendor": "node scripts/check-vendor.ts",
    "vendor:sync": "node scripts/vendor-sync.ts",
    "check:engine-chunks": "node scripts/check-engine-chunks.ts",
    "check:docs-text": "node scripts/check-docs-text.ts",
    "docs:build": "node scripts/docs-site.ts",
    "docs:serve": "pnpm exec vite build --config e2e/vite.config.ts && pnpm exec vite preview --config e2e/vite.config.ts",
    "check:docs-site": "node scripts/docs-site.ts",
    "check:release-files": "node scripts/release-files.ts --check",
    "release:files": "node scripts/release-files.ts",
    "release:dry-run": "pnpm build && node scripts/release-dry-run.ts",
    "changeset": "changeset",
    "build:cdn": "node scripts/build-cdn.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@size-limit/esbuild": "14.2.0",
    "@size-limit/file": "14.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.2.0",
    "svelte": "5.57.3",
    "ts5": "npm:typescript@5.9.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue": "3.5.44",
    "werift": "0.25.1"
  }
}
